# Database (Example)
POSTGRES_DSN="host=localhost port=5432 user=postgres password=postgres dbname=foodbridge sslmode=disable TimeZone=Asia/Bangkok"

# MinIO (Local Default)
S3_ENDPOINT=localhost:9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=foodbridge
PUBLIC_BASE_URL=http://localhost:9000/foodbridge

# JWT
JWT_SECRET=change_me_please

# Port
PORT=1323

# Cloudinary (Leave blank or use placeholders)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
STORAGE_DRIVER=cloudinary_unsigned
